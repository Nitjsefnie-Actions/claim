# The coverage configuration the tests workflow's test-ratchet `run` steps
# keep. claim.py runs as a SUBPROCESS of the suite's cases (the gh stub is a
# bash script); the action measures the Python processes the tests start.
#
# `include` scopes the REPORT to claim.py -- the subject the floor in
# .github/ci-thresholds.json gates; the suite's own inline helpers are
# measured too and do not appear in the report.

[run]
parallel = True

[report]
include = claim.py
